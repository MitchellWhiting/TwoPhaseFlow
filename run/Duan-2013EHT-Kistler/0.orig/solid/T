FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];
internalField uniform 382.15;

boundaryField
{
    bottom
    {
        type    zeroGradient;
        // type            externalWallHeatFluxTemperature;
        // mode            flux;
        // q               constant 28700;
        // kappaMethod     solidThermo;
        // value           uniform 382,15;
    }
   
    side
    {
        type    zeroGradient;
    }

    solid_to_heater
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod    solidThermo;
        value          uniform 382.15;
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }

    axis
    {
        type             empty;
    }
}
       


