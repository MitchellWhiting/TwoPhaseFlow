        const scalar heatFlux = 28.7e03; 
        const scalar Heater_thickness = 0.7e-06;
       
        // Apply the source
        forAll(cellx, i)
        {
            heSource[i] -= heatFlux*V[i]/(cell_thickness); 
        }

