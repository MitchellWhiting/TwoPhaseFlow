FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   101.96; //Sapphire
    }

    transport
    {
      kappa       35;
    }

    thermodynamics
    {
       Hf          0;
       Cp          750;
    }

    equationOfState
    {
       rho         3980;
    }
}


